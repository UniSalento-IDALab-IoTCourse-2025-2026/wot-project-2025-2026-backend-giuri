# Ignora i dati grezzi dei database
mosquitto/data/
mosquitto/log/

# Se i volumi di mysql e mongo salvano i dati in cartelle locali, ignorale
mysql_data/
mongo_data/
.database_data/

# File di ambiente con password o chiavi segrete
.env

# Cache di Python e ambienti virtuali
__pycache__/
*.pyc
.venv/
venv/
env/
.vscode/

dataset/

backend/ai/trained/*.pkl

# Cache di Python (file compilati bytecode)
**/__pycache__/
*.py[cod]
*$py.class

mosquitto/logs/

# Chiavi private TLS (i .crt restano versionabili, sono pubblici)
mosquitto/certs/*.key
mosquitto/certs/*.srl

# Vecchi certificati OpenSSL (sostituiti da mkcert), tenuti solo localmente
mosquitto/certs/old/*